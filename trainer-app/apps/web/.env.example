# Backend API base URL (FastAPI). Defaults to http://localhost:8095 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8095
# Set to 'true' ONLY for the offline demo (canned data + fake coach auto-login).
# Leave unset/false in production so the dashboard uses the real API + real auth.
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
